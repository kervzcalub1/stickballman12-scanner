# Copy to .env and fill in. These are SERVER-SIDE only and are never sent to
# the browser. On Vercel, set the same keys under Project → Settings →
# Environment Variables.

# --- Alias (UPC search) ---
ALIAS_EMAIL=teamstickballman12llc@gmail.com
ALIAS_PASSWORD=your-alias-password

# --- KicksDB (SKU search) ---
KICKSDB_KEY=KICKS-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# --- App access gate ---
# Password users type to enter the app. Leave blank to DISABLE the gate (dev only).
APP_PASSWORD=choose-a-strong-password
# Secret used to sign session tokens. Min 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Send to Sheet (n8n webhook) ---
# n8n Production webhook URL. Receives { name, sku, variants:[{size,quantity}] }.
# If unset, submissions are validated and acknowledged as a stub.
SHEET_WEBHOOK_URL=https://your-n8n-host/webhook/add-to-sheet

# Copy to .env and fill in. These are SERVER-SIDE only and are never sent to
# the browser. On a real host, set the same keys in the host's env settings.

# --- UPC search providers ---
# PRIMARY:  StockX UPC Search (Railway bypass host) needs NO key — it is called
#           server-side at a fixed URL with just the scanned UPC.
# FALLBACK: Alias, used only when StockX returns nothing/errors.
ALIAS_EMAIL=teamstickballman12llc@gmail.com
ALIAS_PASSWORD=your-alias-password

# --- KicksDB (SKU search) ---
KICKSDB_KEY=KICKS-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# --- Accounts & access ---
# PostgreSQL connection string (V5: real database; Google Sheets removed).
# Local dev (Homebrew Postgres):  postgres://<your-mac-user>@localhost:5432/stickballman
# Managed host: include ?sslmode=require — the app enables TLS automatically.
# After setting it, create/upgrade the tables once:  npm run db:setup
DATABASE_URL=postgres://USER@localhost:5432/stickballman
# The admin account: username is always "admin", name is "Alex"; this is its
# password. Use a strong value in production.
ADMIN_PASSWORD=choose-a-strong-admin-password
# The superadmin account (env-based, like admin). Same privileges as admin PLUS
# access to the PH-team pages. Both username and password are configurable.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=choose-a-strong-superadmin-password
# Secret used to sign session tokens. Min 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Shipment tracking (17TRACK) — Purchase Order feature, optional ---
# Multi-carrier tracking for PO shipping labels. All tracking features no-op
# unless TRACKING_API_KEY is set (get one from your 17TRACK account). On ship,
# each label's number is registered; status arrives via the webhook below or an
# on-demand pull (POST /api/po/track-refresh).
# TRACKING_API_KEY=your-17track-api-key
# Shared secret for the inbound webhook. Configure 17TRACK to POST to
#   https://<host>/api/po/tracking-webhook?secret=<this value>
# Requests without a matching ?secret= (or X-Webhook-Secret header) are rejected.
# TRACKING_WEBHOOK_SECRET=some-long-random-string

# --- Server ---
# Port for the production Express server (npm start). Defaults to 3000 over
# plain HTTP, or 80 (the HTTP→HTTPS redirect listener) when TLS is enabled below.
# PORT=3000

# Number of trusted reverse proxies in front of the app, for deriving the real
# client IP used by rate-limiting / login throttling. X-Forwarded-For is
# client-spoofable, so we only trust it when this is set. Railway = 1. Leave
# unset (0) in local dev / direct exposure — then the unspoofable socket IP is
# used. Setting this too high lets a client forge its IP and dodge the limiter.
# TRUST_PROXY_HOPS=1

# --- HTTPS / TLS (optional) ---
# Set BOTH TLS_CERT and TLS_KEY (paths to PEM files) to terminate TLS in Node:
# the app serves HTTPS on HTTPS_PORT (default 443) and redirects all HTTP→HTTPS.
# Leave unset if TLS is handled by a reverse proxy (Caddy/nginx/Cloudflare) or
# in local dev — the app then runs plain HTTP on PORT.
# TLS_CERT=/etc/ssl/certs/fullchain.pem
# TLS_KEY=/etc/ssl/private/privkey.pem
# TLS_CA=/etc/ssl/certs/chain.pem
# HTTPS_PORT=443

# --- Cloudflare R2 (listing photos, V6 Feature 5) ---
# S3-compatible object storage for the per-SKU listing photos shot during
# receiving. When unset, photo capture is hidden and the endpoints return a
# clear "not configured" error (the rest of the app is unaffected).
# Create an R2 bucket + an API token (Object Read & Write), then set:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=stickballman-photos
# Optional: override the endpoint host (defaults to <account>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# Public base URL used to READ the images (R2.dev subdomain or a custom domain
# bound to the bucket). Required for the photos to display / be pulled by listers.
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# NOTE: add a CORS policy on the bucket allowing PUT from the app origin, e.g.
#   [{"AllowedOrigins":["https://your-app"],"AllowedMethods":["PUT"],"AllowedHeaders":["*"]}]

# --- PH "Brand & Fill" background removal (api/_lib/cutout.js) ---
# The cutout step has two providers. Default 'local' runs BiRefNet in-process on CPU:
# great quality, but ~1 GB model in RAM + ~45-50 s/image — it OOMs / times out a small
# web dyno (Railway) and returns 502. On such hosts, offload to hosted remove.bg:
#   1. Get an API key at https://www.remove.bg/dashboard#api-key (paid per image).
#   2. Set REMOVEBG_API_KEY below. That alone switches the provider to 'removebg'.
# Leave unset on a dev box to keep the free in-process model.
# REMOVEBG_API_KEY=...
# Optional explicit override: 'local' or 'removebg' (wins over the key auto-detect).
# CUTOUT_PROVIDER=removebg

# Copy to .env and fill in. These are SERVER-SIDE only and are never sent to
# the browser. On Vercel, set the same keys under Project → Settings →
# Environment Variables.

# --- UPC search providers ---
# PRIMARY:  StockX UPC Search (Railway bypass host) needs NO key — it is called
#           server-side at a fixed URL with just the scanned UPC.
# FALLBACK: Alias, used only when StockX returns nothing/errors.
ALIAS_EMAIL=teamstickballman12llc@gmail.com
ALIAS_PASSWORD=your-alias-password

# --- KicksDB (SKU search) ---
KICKSDB_KEY=KICKS-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# --- Accounts & access (v3) ---
# Postgres (Neon) connection string. On Vercel this is added automatically when
# you attach the Neon integration; locally, copy it from `vercel.env`.
# After setting it, create the tables once:  npm run db:setup
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# The admin account: username is always "admin", name is "Alex"; this is its
# password. Use a strong value in production.
ADMIN_PASSWORD=choose-a-strong-admin-password
# Secret used to sign session tokens. Min 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# (APP_PASSWORD from v1/v2 is no longer used — accounts replace the shared gate.)

# --- Send to Sheet (Google Sheets API) ---
# Appends one row per variant (columns A–J):
#   [ unique_id, scanned_by, name, sku, size, quantity, price, status, remarks, added_by ]
# Column A (unique_id) should be hidden + protected in the sheet, with the
# service account granted edit access — the write path uses it to verify each
# row survived concurrent appends and re-writes any that were overwritten.
# If these are unset, submissions are validated and acknowledged as a stub.
#
# Spreadsheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS-IS-THE-ID>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id
# Tab/sheet name to append to (optional; defaults to "Sheet1").
GOOGLE_SHEET_TAB=Sheet1
# Service account credentials (from its JSON key file).
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa-name@your-project.iam.gserviceaccount.com
# The "private_key" value. Keep the literal \n escapes; wrap the whole thing in
# double quotes. On Vercel, paste it as a single line with \n sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
